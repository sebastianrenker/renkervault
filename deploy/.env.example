# RenkerVault relay — environment variables
# Copy to server/.env (or set as real environment variables) and adjust.
# See deploy/DEPLOYMENT.md for the complete hosting procedure.

# Port the relay listens on.
PORT=8787

# Bind address:
#  - 127.0.0.1  RECOMMENDED when a reverse proxy (Caddy/nginx) runs in front
#               on the same host (the default case, see Caddyfile).
#  - 0.0.0.0    only set this if the relay should be reachable directly from
#               the internet WITHOUT a reverse proxy — then you MUST set
#               TLS_CERT_FILE/TLS_KEY_FILE below, otherwise everything runs in cleartext!
HOST=127.0.0.1

# Only needed if NO reverse proxy runs in front and the relay should terminate
# TLS itself (native wss:// directly from the Node process). Certificate and
# key must be renewed manually BEFORE expiry (no auto-renewal like with Caddy)
# — hence the reverse-proxy variant is recommended.
# TLS_CERT_FILE=/path/to/fullchain.pem
# TLS_KEY_FILE=/path/to/privkey.pem

# Only enable this if a TRUSTED reverse proxy (e.g. Caddy on the same host)
# sets the X-Forwarded-For header — otherwise clients could spoof an arbitrary
# IP and bypass the rate limit / connection cap.
# TRUST_PROXY=1

# Recommended for every publicly reachable relay with a fixed, shipped web
# client (e.g. at https://chat.yourdomain.com): a comma-separated list of
# allowed origins. Connections from browsers with a different origin are then
# rejected at the WebSocket handshake (403) before any message is processed —
# this prevents arbitrary foreign websites from abusing the relay via a
# victim's browser for lookups/enumeration. Native clients (Tauri/Android)
# send no Origin header and are not affected. Leave empty for local
# development (web client and relay deliberately run on different localhost
# ports there).
# ALLOWED_ORIGINS=https://chat.yourdomain.com
