# Tor hidden-service configuration for the RenkerVault relay.
# ================================================================
# Makes the relay reachable exclusively via a .onion address:
#  - The server needs NO public IP/domain and NO TLS certificate anymore
#    (Tor encrypts and authenticates the entire channel itself).
#  - Neither the relay operator nor a network observer learns the real
#    IP address of the clients — and conversely, clients do not know the
#    real IP address of the server.
#  - Reachable ONLY via Tor Browser or a client with a Tor connection
#    (e.g. a system-wide Tor service + SOCKS5 proxy).
#
# Setup (Debian/Ubuntu):
#   sudo apt install tor
#   Append these lines to /etc/tor/torrc, then:
#   sudo systemctl restart tor
#   sudo cat /var/lib/tor/renkervault/hostname   # shows the .onion address

HiddenServiceDir /var/lib/tor/renkervault/
HiddenServicePort 80 127.0.0.1:8787

# The relay itself needs NO TLS for this (HOST=127.0.0.1, no
# TLS_CERT_FILE/TLS_KEY_FILE in the .env) — Tor handles encryption and
# authentication of the entire connection already at the network level.
#
# In the app under Settings -> Relay server:
#   ws://<your-onion-address>.onion
# — for this the connection must run over Tor (Tor Browser for the
# web client, or a system-wide Tor SOCKS5 proxy for the desktop/mobile
# app). See DEPLOYMENT.md, section "Path 3".
