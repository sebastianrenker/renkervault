[Unit]
Description=RenkerVault Content-Blind Relay
After=network.target

[Service]
Type=simple
User=renkervault
Group=renkervault
WorkingDirectory=/opt/renkervault/server
EnvironmentFile=/opt/renkervault/server/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5

# Hardening (systemd sandbox) — the relay needs no privileges at all,
# no filesystem access (beyond its own working directory) and no network
# capabilities beyond the normal server socket.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/renkervault/server
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
