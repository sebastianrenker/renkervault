# Caddyfile for the RenkerVault relay.
# Replace the domain with your own (sub)domain that points at the server IP.
# Caddy obtains and renews the TLS certificate automatically (Let's Encrypt)
# and forwards WebSocket connections transparently to the locally running
# Node relay — no extra WebSocket configuration flag needed.

chat.yourdomain.com {
    reverse_proxy 127.0.0.1:8787

    # DDoS / connection-flood protection (hardening roadmap item 9, SECURITY.md
    # section 4 item 12): the relay itself already limits per socket
    # (30 messages/s) and per IP (20 concurrent connections), see
    # server/src/index.js — but that only protects against ONE single IP origin
    # pattern, not distributed requests across many IPs (real DDoS). Vanilla
    # Caddy has NO built-in rate limiting (a deliberate design decision by the
    # Caddy maintainers) — the line below needs the plugin
    # github.com/mholt/caddy-ratelimit and a custom Caddy build:
    #
    #   xcaddy build --with github.com/mholt/caddy-ratelimit
    #
    # Then replace the `caddy` system command with the self-built binary
    # and uncomment this block:
    #
    # rate_limit {
    #     zone dynamic_relay {
    #         key {remote_host}
    #         events 120
    #         window 1m
    #     }
    # }
}

# For real protection against DISTRIBUTED requests (many IPs at once) a
# reverse-proxy setting is no longer enough — for that an upstream
# CDN/DDoS protection service (e.g. Cloudflare in "Proxied" mode) is the
# realistic approach, see DEPLOYMENT.md, section "DDoS protection".

# Optional: additionally securing/logging access to the HTTP status endpoint
# can be added here (e.g. a log directive, an IP allowlist for /admin-like
# endpoints). The relay itself currently has no such endpoints.
